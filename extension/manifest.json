{
  "manifest_version": 3,
  "name": "EPUB Downloader by devploit",
  "version": "1.0.3",
  "author": "devploit",
  "description": "Rebuild and save EPUB books from epub.pub using your browser session.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["https://epub.pub/*", "https://*.epub.pub/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open EPUB Downloader by devploit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" }
}
